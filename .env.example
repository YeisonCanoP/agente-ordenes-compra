# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube al repositorio.

# Clave del proveedor del modelo (obligatoria para el chat; demo.ts y los tests no la necesitan)
OPENAI_API_KEY=

# Modelo de OpenAI que usa el agente
OPENAI_MODEL=gpt-4.1-mini

# Tiempo máximo de espera por respuesta del modelo, en milisegundos
LLM_TIMEOUT_MS=60000

# Tope de tokens de salida por respuesta del modelo
MAX_TOKENS_RESPUESTA=4000

# Tope de iteraciones herramienta → modelo por turno (CA1)
MAX_ITERACIONES=25

# Tope de tokens (entrada + salida) por sesión de chat
MAX_TOKENS_SESION=300000

# Tope global de tokens por día, sumando todas las sesiones
MAX_TOKENS_DIA=500000

# Clave de acceso al chat (opcional). Si se define, el front la pide antes de conversar
ACCESS_KEY=

# Puerto del servidor HTTP
PORT=3000
